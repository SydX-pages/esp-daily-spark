# ESP32-C3 Mini: 4 MB embedded flash
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"

# Console on the native USB-Serial/JTAG port (/dev/ttyACM0)
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# The WiFi stack + fonts push the image past 1 MB, so use the large app slot
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Primary + fallback NTP server
CONFIG_LWIP_SNTP_MAX_SERVERS=2

# 4.2 inch 400x300 panel on this board uses SSD1683 (fixed, no other controller)

# Optional first-boot WiFi fallback. Leave empty and use the Daily-Spark portal;
# credentials entered there are stored in NVS and override these values.
CONFIG_GIFT_WIFI_SSID=""
CONFIG_GIFT_WIFI_PASSWORD=""
